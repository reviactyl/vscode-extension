{
  "name": "reviactyl-vsc",
  "displayName": "Reviactyl",
  "description": "Manage your Reviactyl Server",
  "repository": {
    "type": "git",
    "url": "https://github.com/reviactyl/vscode-extension.git"
  },
  "version": "26.0.0-dev",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:reviactyl"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "reviactyl-vsc.editConfig",
        "title": "Edit Extension Config File",
        "category": "Reviactyl"
      },
      {
        "command": "reviactyl-vsc.removePanel",
        "title": "Remove Panel",
        "category": "Reviactyl"
      },
      {
        "command": "reviactyl-vsc.openPanelServer",
        "title": "Open Reviactyl Server",
        "category": "Reviactyl"
      },
      {
        "command": "reviactyl-vsc.init",
        "title": "Add Reviactyl panel",
        "shortTitle": "Add Panel",
        "category": "Reviactyl"
      },
      {
        "command": "reviactyl-vsc.reset",
        "title": "Reset workspace config",
        "shortTitle": "Reset",
        "category": "Reviactyl"
      },
      {
        "command": "reviactyl-vsc.refresh",
        "title": "Refresh server files",
        "shortTitle": "Refresh",
        "category": "Reviactyl"
      },
      {
        "command": "reviactyl-vsc.switchServer",
        "title": "Switch server",
        "category": "Reviactyl"
      },
      {
        "command": "reviactyl-vsc.powerStart",
        "title": "Start server",
        "category": "Reviactyl",
        "icon": "$(play)"
      },
      {
        "command": "reviactyl-vsc.powerStop",
        "title": "Stop server",
        "category": "Reviactyl",
        "icon": "$(debug-stop)"
      },
      {
        "command": "reviactyl-vsc.powerRestart",
        "title": "Restart server",
        "category": "Reviactyl",
        "icon": "$(debug-restart)"
      },
      {
        "command": "reviactyl-vsc.powerKill",
        "title": "Kill server",
        "category": "Reviactyl",
        "icon": "$(circle-slash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reviactyl",
          "title": "Reviactyl",
          "icon": "./media/reviactyl.svg"
        }
      ]
    },
    "views": {
      "reviactyl": [
        {
          "id": "reviactyl.panels",
          "name": "Reviactyl",
          "icon": "./media/reviactyl.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "reviactyl-vsc.init",
          "when": "view == reviactyl.panels",
          "group": "navigation@1"
        },
        {
          "command": "reviactyl-vsc.refresh",
          "when": "view == reviactyl.panels",
          "group": "navigation@2"
        },
        {
          "command": "reviactyl-vsc.editConfig",
          "when": "view == reviactyl.panels",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "reviactyl-vsc.removePanel",
          "when": "view == reviactyl.panels && viewItem == reviactylPanel",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "reviactyl-vsc.editConfig"
        },
        {
          "command": "reviactyl-vsc.init"
        },
        {
          "command": "reviactyl-vsc.reset",
          "when": "workbenchState == workspace"
        },
        {
          "command": "reviactyl-vsc.refresh",
          "when": "workbenchState == workspace"
        },
        {
          "command": "reviactyl-vsc.switchServer"
        },
        {
          "command": "reviactyl-vsc.powerStart"
        },
        {
          "command": "reviactyl-vsc.powerStop"
        },
        {
          "command": "reviactyl-vsc.powerRestart"
        },
        {
          "command": "reviactyl-vsc.powerKill"
        }
      ],
      "editor/title": [
        {
          "command": "reviactyl-vsc.powerStart",
          "when": "resourceScheme == reviactyl",
          "group": "navigation@1"
        },
        {
          "command": "reviactyl-vsc.powerStop",
          "when": "resourceScheme == reviactyl",
          "group": "navigation@2"
        },
        {
          "command": "reviactyl-vsc.powerRestart",
          "when": "resourceScheme == reviactyl",
          "group": "navigation@3"
        },
        {
          "command": "reviactyl-vsc.powerKill",
          "when": "resourceScheme == reviactyl",
          "group": "navigation@4"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "explorer",
        "contents": "Open a Reviactyl server folder as a remote workspace.\n[Add Reviactyl panel](command:reviactyl-vsc.init)",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "reviactyl.panels",
        "contents": "Add a Reviactyl panel to browse its servers and live status.\n[Add Panel](command:reviactyl-vsc.init)  [Edit Extension Config File](command:reviactyl-vsc.editConfig)"
      }
    ],
    "configuration": {
      "title": "Reviactyl file system",
      "properties": {
        "reviactyl-vsc.panelUrl": {
          "type": "string",
          "default": "",
          "description": "Reviactyl panel URL to connect to.",
          "format": "uri"
        },
        "reviactyl-vsc.panels": {
          "type": "array",
          "default": [],
          "description": "Configured Reviactyl panels. API keys are stored separately in VS Code SecretStorage.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "panelUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "id",
              "name",
              "panelUrl"
            ]
          }
        },
        "reviactyl-vsc.activePanelId": {
          "type": "string",
          "default": "",
          "description": "ID of the active named panel."
        },
        "reviactyl-vsc.apiKey": {
          "type": "string",
          "default": "",
          "description": "Legacy API key setting; existing values are migrated to VS Code SecretStorage.",
          "deprecationMessage": "API keys are now stored securely in VS Code SecretStorage.",
          "minLength": 48,
          "maxLength": 48,
          "pattern": "^rtlc_[a-zA-Z0-9]{43}$",
          "patternErrorMessage": "Invalid client API key."
        },
        "reviactyl-vsc.serverId": {
          "type": "string",
          "default": "",
          "description": "Short server identifier returned by the Reviactyl client API.",
          "minLength": 8,
          "maxLength": 8,
          "pattern": "^[a-z0-9]{8}$",
          "patternErrorMessage": "Invalid short server identifier."
        },
        "reviactyl-vsc.proxyUrl": {
          "type": "string",
          "default": "",
          "description": "CORS proxy to use. Leave empty to disable.",
          "pattern": "^(https?://.+)?$"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "package:vsix": "pnpm run package && vsce package",
    "compile-tests": "tsc -p . --noEmit false --outDir out",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "pnpm run compile-tests && node --test out/test/apiClient.test.js"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
